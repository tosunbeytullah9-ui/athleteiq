{
  "name": "athleteiq",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:rls": "vitest run tests/rls",
    "test:e2e": "playwright test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:gen:types": "supabase gen types typescript --local > packages/db/types.ts",
    "docs:sync": "node scripts/docs-sync.mjs",
    "landing:seed": "node scripts/landing/demo-seed.mjs",
    "landing:capture": "node scripts/landing/capture.mjs",
    "landing:replicas": "node scripts/landing/record-replicas.mjs",
    "landing:backgrounds": "node scripts/landing/fetch-backgrounds.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "pg": "^8.23.1",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
