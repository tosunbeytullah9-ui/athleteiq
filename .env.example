# =============================================================
# AthleteIQ — Environment Variables
# Kopyala: cp .env.example .env.local
# ASLA .env.local dosyasını commit etme!
# =============================================================

# ------ Supabase ------
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=xxx

# ------ WHOOP (developer.whoop.com) ------
WHOOP_CLIENT_ID=xxx
WHOOP_CLIENT_SECRET=xxx
WHOOP_REDIRECT_URI=http://localhost:3000/api/wearables/whoop/callback
WHOOP_WEBHOOK_SECRET=xxx

# ------ Polar (admin.polaraccesslink.com) ------
POLAR_CLIENT_ID=xxx
POLAR_CLIENT_SECRET=xxx
POLAR_REDIRECT_URI=http://localhost:3000/api/wearables/polar/callback

# ------ Fitbit (dev.fitbit.com — "Server" tipinde uygulama) ------
FITBIT_CLIENT_ID=xxx
FITBIT_CLIENT_SECRET=xxx
FITBIT_REDIRECT_URI=http://localhost:3000/api/wearables/fitbit/callback

# ------ Email (resend.com) ------
RESEND_API_KEY=re_xxx
# Demo talep formu bildirimi (landing → /api/demo-request). Boşsa talepler yine
# kaydedilir ve /admin/demo-requests'te görünür, yalnızca e-posta gitmez.
# Resend'in test göndericisi (onboarding@resend.dev) yalnızca Resend hesabının
# sahibine gönderir — alıcı o hesabın e-postası olmalı ya da alan adı doğrulanmalı.
DEMO_REQUEST_NOTIFY_EMAIL=
DEMO_REQUEST_FROM_EMAIL=
# Hız sınırı için IP özetinin tuzu (rastgele uzun bir değer)
DEMO_REQUEST_IP_SALT=

# ------ App ------
NEXT_PUBLIC_APP_URL=http://localhost:3000
