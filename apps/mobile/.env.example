# apps/mobile ortam değişkenleri — kopyalayıp .env olarak doldurun (yerel geliştirme).
# EXPO_PUBLIC_* değerleri derleme anında JS paketine gömülür. EAS bulut derlemesi
# git'e girmeyen .env'i YÜKLEMEZ — production/preview değerleri `eas env:create`
# ile girilir (görünürlük: plaintext veya sensitive; "secret" EXPO_PUBLIC_* için uygun değil).

# Supabase — ikisi de ZORUNLU: yoksa uygulama açılışta çöker (lib/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# apps/web'in (WHOOP OAuth authorize/callback route'larını barındıran) adresi.
# Android emülatör: http://10.0.2.2:3000 · Fiziksel cihaz: http://<LAN-IP>:3000
# Production: https://loadwell.app. Yanlışsa WHOOP bağlantısı çalışmaz.
EXPO_PUBLIC_APP_URL=http://10.0.2.2:3000
